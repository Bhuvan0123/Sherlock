# ============================================================
# K4K Team Lead Assistant - environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ============================================================

# ---------- Azure DevOps (READ-ONLY) ----------
# The server performs read operations only. A least-privilege PAT is strongly
# recommended: Work Items (Read), Project and Team (Read), Identity (Read),
# Analytics (Read), Graph (Read). Do NOT grant write/manage scopes.
ADO_ORGANIZATION=KEBS4KAAR
ADO_PROJECT=K4K
ADO_TEAM=Platform
ADO_PAT=

# Azure DevOps REST API version used for all requests.
ADO_API_VERSION=7.1

# ---------- Microsoft Graph (email sending) ----------
# Separate credentials from the Azure DevOps PAT. Minimum application
# permission required: Mail.Send (application), admin-consented.
# Optional: leave blank to run the server with email sending disabled
# (draft tools still work; sending reports a clear configuration error).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Mailbox that outbound mail is sent from (must exist in the tenant).
EMAIL_SENDER=

# Optional allowlist. When set, mail may only be sent to these addresses or
# domains (comma-separated, e.g. "team@kaartech.com,@kaartech.com").
EMAIL_ALLOWED_RECIPIENTS=

# ---------- Local Team Lead activity database ----------
# SQLite file used for the Team Lead audit trail, email drafts and send log.
# Accepts `file:./relative/path.sqlite`, an absolute path, or `:memory:`.
DATABASE_URL=file:./data/k4k-tl.sqlite

# ---------- Runtime ----------
# silent | error | warn | info | debug (all logs go to stderr)
LOG_LEVEL=info

# Cache time-to-live in seconds for slow-changing Azure DevOps metadata
# (project, teams, members, iterations). Work-item queries use a shorter TTL.
CACHE_TTL_SECONDS=300

# How long an email draft stays valid for confirmation, in minutes.
EMAIL_DRAFT_TTL_MINUTES=60
