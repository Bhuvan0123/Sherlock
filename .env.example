# ============================================================
# S.H.E.R.L.O.C.K. - environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ============================================================

# ---------- Azure DevOps (READ-ONLY) ----------
ADO_ORGANIZATION=KEBS4KAAR
ADO_PROJECT=K4K
ADO_TEAM=Platform
ADO_PAT=your_personal_access_token

# Azure DevOps REST API version used for all requests.
ADO_API_VERSION=7.1

# ---------- Local runtime database ----------
# SQLite file used for the local audit trail and custom skill persistence.
# Accepts `file:./relative/path.sqlite`, an absolute path, or `:memory:`.
DATABASE_URL=file:./data/sherlock.sqlite

# ---------- Runtime ----------
SHERLOCK_ENV=development
# silent | error | warn | info | debug (all logs go to stderr)
LOG_LEVEL=info
TOKEN_DEBUG=false

# Cache time-to-live in seconds for slow-changing Azure DevOps metadata
# (project, teams, members, iterations). Work-item queries use a shorter TTL.
CACHE_TTL_SECONDS=300
