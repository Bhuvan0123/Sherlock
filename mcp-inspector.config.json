{
  "mcpServers": {
    "sherlock": {
      "command": "npx",
      "args": ["-y", "tsx", "src/index.ts"],
      "env": {
        "LOG_LEVEL": "debug"
      }
    },
    "sherlock-dist": {
      "command": "node",
      "args": ["dist/index.js"],
      "env": {
        "LOG_LEVEL": "info"
      }
    }
  }
}
